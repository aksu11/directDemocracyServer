# Server
PORT=3000

# Tuotannon web-origins, jotka saavat kutsua APIa selaimesta (pilkulla erotettuna).
# Paikallinen localhost/127.0.0.1 on aina sallittu automaattisesti kehitystä varten.
# CORS_ORIGINS=https://your-web-app.com

# Firebase – choose ONE of the two options below:

# Option A: path to the downloaded service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: inline JSON (useful for cloud deployments / environment variable injection)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Salt used when hashing device IDs – change to a long random string in production
DEVICE_ID_SALT=change-me-to-a-long-random-secret

# Google-kirjautuminen: pilkulla erotetut OAuth-client id:t (web, iOS, Android)
# jotka expo-auth-session tuottaa clientille. Vaaditaan äänestyksiin joissa
# requiresLogin === true. Hae nämä Google Cloud Consolen "APIs & Services > Credentials"
# -sivulta (OAuth 2.0 Client IDs).
# GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-ios.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com

# Shared admin password for the /admin page (all 3-5 admins use the same password)
ADMIN_PASSWORD=change-me-to-a-strong-password
